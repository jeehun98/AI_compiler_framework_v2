{
  "name": "aicf-minimal-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "report": "python ../demo.py --output public/report.json",
    "predev": "npm run report",
    "dev": "vite",
    "pretypecheck": "npm run report",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run report",
    "test": "vitest run",
    "prebuild": "npm run report",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
